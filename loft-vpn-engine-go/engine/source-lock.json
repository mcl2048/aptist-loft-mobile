  "protocols": [
    {
      "id": "hyrakenx",
      "core_path": "modules/hyrakenx",
      "adapter_path": "GhostX-core-main/protocol/hyrakenx/hyrakenx.go",
      "local_dependencies": [
        "pkg/hyrakenquic",
        "modules/firewall/hydra",
        "pkg/trafficprofile"
      ],
      "outer_transport": "authenticated UDP gate, QUIC, TLS 1.3, mandatory mutual certificate verification",
      "udp_adapter_path": "modules/hyrakenx/packetconn.go",
      "udp_payload_min": 1,
      "udp_payload_max": 1024,
      "udp_transport": "fixed_target_reliable_stream",
      "native_quic_datagram_is_a_different_api": true,
      "close_semantics": "Outbound.Close retires admission and cancels undelivered owners; active Peer survives until final tracked reference release. No automatic drain deadline.",
      "stream_close_semantics": "CloseWrite retains queued FIN; ForceClose cancels both directions.",
      "owned_socket_queue_semantics": "Best effort requested maximum 1 MiB per direction on owned UDP socket before gate wrapping; Linux effective accounting may double this. This is not a mobile memory limit."
    },
    {
      "id": "hyraken-pro",
      "core_path": "pkg/hyrakenpro",
      "adapter_path": "GhostX-core-main/protocol/hyrakenpro/outbound.go",
      "outer_transport": "TLS 1.3 over TCP; raw TCP or custom bidirectional gRPC byte-stream carrier",
      "authentication": "verified server TLS plus seed-authenticated X25519 and ML-KEM-768 hybrid session handshake and mutual key confirmation",
      "udp_payload_min": 0,
      "udp_payload_max": 65507,
      "udp_envelope_max": 66023,
      "udp_transport": "reliable_tcp_or_custom_grpc",
      "empty_udp_is_valid": true,
      "legacy_udp_pool": "ordinary pool shared with TCP",
      "xudp_pool": "separate packetOnly pool, explicitly negotiated",
      "pool_semantics": "Connections is a base pool target; ElasticMux=false does not establish a physical FD cap. Type/capacity growth and in-flight/address-race dials require mobile admission at resource creation.",
      "close_semantics": "Client.Close and Outbound.Close terminate the owned pool and join workers; this is not Drain.",
      "stream_close_semantics": "Stream.CloseWrite preserves half-close and reverse replies. Relay 30 second EOF drain applies only to its gateway bridge path.",
      "release_path": "8.0.32 retains production carrier/record implementations; rejected private gRPC borrow candidate is not imported."
    }
